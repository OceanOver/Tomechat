# Copy to .env and fill in actual values; real environment variables with the same name take precedence over this file
# The LLM service and the embedding service are configured independently and may use different providers.

# ── LLM service ──────────────────────────────────────────────
# Model service API address (OpenAI-compatible endpoint)
MODEL_API_BASE=https://api.openai.com/v1
# Model service API key (required, otherwise the chat endpoint reports Missing credentials after startup)
MODEL_API_KEY=
# Default chat model
MODEL_CHAT_MODEL=gpt-4o-mini
# Model platform type: openai = OpenAI-compatible endpoint; gemini = Google native SDK (tool calls use the native protocol;
# Gemini 3 thinking models return 400 on the compatible endpoint due to missing thought_signature round-trip, use gemini)
MODEL_PLATFORM_TYPE=openai
# Local proxy for accessing the model service (leave empty for direct connection)
MODEL_API_PROXY=

# ── Embedding service (may use a different provider; unset fields fall back to the LLM service) ──
# Default embedding model
MODEL_EMBEDDING_MODEL=text-embedding-3-small
# Embedding service endpoints, configured independently of the LLM service
MODEL_EMBEDDING_API_BASE=
MODEL_EMBEDDING_API_KEY=
MODEL_EMBEDDING_API_PROXY=

# Tavily web search API key (required for agent chat with search_engine: true)
TAVILY_API_KEY=
