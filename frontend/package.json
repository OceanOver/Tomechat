{
  "name": "tomechat",
  "version": "0.1.0",
  "description": "Web app for everyday chat and knowledge-base RAG, powered by a self-hosted backend.",
  "keywords": [
    "chatbot",
    "rag",
    "knowledge-base",
    "nextjs",
    "react",
    "zustand",
    "dexie",
    "fastapi"
  ],
  "author": "tomechat",
  "sideEffects": false,
  "scripts": {
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:docker": "DOCKER=true next build",
    "dev": "next dev -p 3010",
    "lint": "pnpm run lint:ts && pnpm run type-check && pnpm run lint:circular",
    "lint:circular": "dpdm \"src/**/*.{ts,tsx}\"  --warning false  --tree false  --exit-code circular:1  -T true",
    "lint:ts": "eslint \"{src,tests}/**/*.{js,jsx,ts,tsx}\" --fix",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:update": "vitest -u",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.19",
    "@assistant-ui/react-markdown": "^0.14.15",
    "@dnd-kit/core": "^6.3.1",
