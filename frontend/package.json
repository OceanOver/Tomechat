    "@types/node": "^20",
    "@types/numeral": "^2.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/rtl-detect": "^1",
    "@types/ua-parser-js": "^0.7",
    "@types/uuid": "^9",
    "@typescript-eslint/eslint-plugin": "7.5.0",
    "@typescript-eslint/parser": "7.5.0",
    "@vitest/coverage-v8": "~1.2.2",
    "autoprefixer": "^10.6.0",
    "dpdm": "^3",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
