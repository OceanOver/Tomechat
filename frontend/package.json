    "i18next-resources-to-backend": "^1",
    "immer": "^10",
    "jose": "^5.2.0",
    "lodash-es": "^4",
    "lucide-react": "^1.46.0",
    "next": "^14.1",
    "numeral": "^2.0.6",
    "nuqs": "^1.15.4",
    "openai": "^4.22",
    "react": "^18",
    "react-dom": "^18",
    "react-hotkeys-hook": "^4",
    "react-i18next": "^14",
    "react-lazy-load": "^4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.4",
    "react-textarea-autosize": "^8.5.9",
    "rehype-external-links": "^3.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "rtl-detect": "^1",
    "sonner": "^2.0.8",
    "swr": "^2",
    "tailwind-merge": "^3.7.0",
